# Static asset caching for the Workers assets setup — the Worker does not
# run in front of static assets, so next.config `headers` do not apply to
# these files. Next.js emits immutable build output under /_next/static;
# matching Next's self-host default avoids per-asset revalidation requests
# (opennext.js.org/cloudflare/caching#static-assets-caching).
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable
