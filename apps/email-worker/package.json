{
  "name": "@rajahinta/email-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Email Worker (migrate-to-cloudflare task 5.3, design D7) — the only sender in the system: Cloudflare Email Service send_email binding behind an internal, shared-secret HTTP contract.",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250509.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.14.0"
  }
}
