{
  "name": "rajahinta",
  "private": true,
  "version": "0.1.0",
  "description": "Rajahinta.fi — Finnish cross-border beverage price index and landed-cost intelligence platform",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:content": "cd apps/frontend && pnpm run lint:content",
    "test": "pnpm -r test",
    "test:golden": "bash scripts/test-golden-dataset.sh",
    "test:integration": "vitest run --config tests/integration/vitest.config.ts",
    "test:d1": "vitest run --config vitest.config.d1.ts",
    "test:data-quality": "bash scripts/test-data-quality.sh",
    "test:data-quality:d1": "vitest run --config vitest.config.d1.ts tests/integration/d1/data-quality.d1.test.ts",
    "test:compliance": "bash scripts/test-compliance.sh",
    "typecheck": "pnpm -r typecheck",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e-browser": "playwright test -c tests/e2e-browser/playwright.config.ts",
    "test:load": "vitest run --config tests/load/vitest.config.ts",
    "load:http": "bash tests/load/artillery/run.sh",
    "clean": "pnpm -r clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "dev:up": "bash scripts/dev-up.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^3.2.0",
    "artillery": "^2.0.34",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9 <10"
  }
}
