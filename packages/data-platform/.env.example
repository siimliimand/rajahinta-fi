# PostgreSQL connection string for the Drizzle ORM provider.
#
# The @rajahinta/data-platform package reads DATABASE_URL at provider
# instantiation time to create a pg.Pool and bind a Drizzle ORM instance.
#
# Format:
#   postgres://<user>:<password>@<host>:<port>/<database>
#
# Examples:
#   DATABASE_URL=postgres://rajahinta:secret@localhost:5432/rajahinta_dev
#   DATABASE_URL=postgres://rajahinta:secret@db.internal:5432/rajahinta_prod
#
# Required by: packages/data-platform/src/db/drizzle.provider.ts
DATABASE_URL=postgres://user:password@localhost:5432/rajahinta_dev