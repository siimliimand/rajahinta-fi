{
  "__inputs": [
    {
      "name": "DS_CF_D1",
      "label": "Rajahinta D1 (Cloudflare D1 query API)",
      "description": "A JSON/Infinity-type Grafana data source POSTing to the Cloudflare D1 query API (https://api.cloudflare.com/client/v4/accounts/{id}/d1/database/{uuid}/query). The token lives in the data source config, never in this file; D1 /query requires an edit-scoped D1 token (see infra/grafana/calendar-watcher-alerts.yaml header).",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_CF_D1}" },
      "description": "Unreviewed source-watcher detections. The watcher over-collects by design (news firehose → human filter), so a non-zero count is normal; growth without review is the failure mode (alert: RajahintaCalendarQueueReviewStale). Live point-in-time value — history lives in the alert state, not here.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 25 },
              { "color": "red", "value": 75 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_CF_D1}" },
          "data": "{\"sql\":\"SELECT COUNT(*) AS pending FROM calendar_event_candidates WHERE status = 'PENDING'\"}",
          "format": "table",
          "method": "POST",
          "parser": "backend",
          "refId": "A",
          "source": "response",
          "type": "json",
          "url": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/d1/database/${D1_DATABASE_ID}/query"
        }
      ],
      "title": "PENDING candidates",
      "type": "stat"
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_CF_D1}" },
      "description": "Age in days of the oldest unreviewed detection (detection time, not publication). Alert line at 7 days = RajahintaCalendarQueueReviewStale.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 7 },
              { "color": "red", "value": 14 }
            ]
          },
          "unit": "d"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_CF_D1}" },
          "data": "{\"sql\":\"SELECT CAST(julianday('now') - julianday(MIN(created_at)) AS INTEGER) AS oldest_pending_age_days FROM calendar_event_candidates WHERE status = 'PENDING'\"}",
          "format": "table",
          "method": "POST",
          "parser": "backend",
          "refId": "A",
          "source": "response",
          "type": "json",
          "url": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/d1/database/${D1_DATABASE_ID}/query"
        }
      ],
      "title": "Oldest PENDING age (days)",
      "type": "stat"
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_CF_D1}" },
      "description": "Hours since the watcher last inserted a detection. Feeds are news-shaped (worst observed quiet gap since 2026-10-17 go-live: 7 days); alert line at 336 h = RajahintaCalendarWatcherInsertSilence. Proxy liveness — the watcher fails open and emits no metric, so silence here is the only D1-visible signal.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 168 },
              { "color": "red", "value": 336 }
            ]
          },
          "unit": "h"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_CF_D1}" },
          "data": "{\"sql\":\"SELECT CAST((julianday('now') - julianday(MAX(created_at))) * 24 AS INTEGER) AS hours_since_last_insert FROM calendar_event_candidates\"}",
          "format": "table",
          "method": "POST",
          "parser": "backend",
          "refId": "A",
          "source": "response",
          "type": "json",
          "url": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/d1/database/${D1_DATABASE_ID}/query"
        }
      ],
      "title": "Hours since last watcher insert",
      "type": "stat"
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_CF_D1}" },
      "description": "Oldest unreviewed detections first — the triage worklist. Accept only items naming an excise rate, tax-table, or price-list change with an official source (acceptance creates a public calendar event); everything else rejects (terminal, retained for URL dedup).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_CF_D1}" },
          "data": "{\"sql\":\"SELECT id, date(published_at) AS published, date(created_at) AS detected, source, substr(title, 1, 70) AS title FROM calendar_event_candidates WHERE status = 'PENDING' ORDER BY created_at ASC LIMIT 15\"}",
          "format": "table",
          "method": "POST",
          "parser": "backend",
          "refId": "A",
          "source": "response",
          "type": "json",
          "url": "https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/d1/database/${D1_DATABASE_ID}/query"
        }
      ],
      "title": "Oldest PENDING candidates (triage worklist)",
      "type": "table"
    }
  ],
  "refresh": "1h",
  "schemaVersion": 39,
  "tags": ["rajahinta", "calendar-event-automation"],
