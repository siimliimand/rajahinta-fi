# ==== Secrets / credentials ====
# .env files are write-only: never committed.
.env
.env.*
!.env.example

# ==== OS / editor ====
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# ==== OpenCode tooling ====
# Local runtime state and generated artifacts for the agentic infrastructure.
# Tracked config (opencode.jsonc, .opencode/agents, commands, plugins, tui,
# opencode-onboard.json) stays committed; local/generated state is ignored.
.opencode/opencode-quota/
.opencode/tmp/
.opencode/.ob-run.json
.opencode/opencode-onboard.user.json
.opencode/opencode-onboard-managed.json
.opencode/source-roots.json
.opencode/*-engineer.*.md
.opencode/node_modules/

# ==== CodeGraph index ====
# Generated code-intelligence index, regenerated on demand.
.codegraph/

# ==== Application (planned/future) ====
# No app stack is selected yet; these cover the common defaults so nothing
# generated later leaks. Revisit once framework/tooling is decided.
node_modules/
dist/
build/
out/
coverage/
*.log

# TypeScript incremental-build state (regenerated on every compile).
*.tsbuildinfo

# ==== Claude Code tooling ====
# Symlinked/cached skills from .agents/skills/ — derived state.
.claude/

# ==== Cloudflare Workers tooling ====
# Generated local state and build output (also covered by nested .gitignore
# files in apps/api-worker and apps/frontend; repeated here so the coverage
# is visible in one place). Deploy-time outputs are rebuilt by wrangler /
# opennextjs-cloudflare; local D1 state lives under .wrangler/state.
.wrangler/
.open-next/
.next/

# ==== Browser E2E (Playwright, tests/e2e-browser) ====
# Run artifacts: traces, screenshots, videos, and the HTML report.
tests/e2e-browser/test-results/
tests/e2e-browser/playwright-report/

# ==== AgentMemory ====
# Local agent-memory state, if persisted to disk.
.agentmemory/